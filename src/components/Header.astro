---
import Logo from './Logo.astro';
import { NAV, SITE } from '../data/site';

interface Props {
  /** The page opens with a full-bleed photo: the header starts transparent with white text and logo. */
  overPhoto?: boolean;
}
const { overPhoto = false } = Astro.props;

const path = Astro.url.pathname;
const isActive = (href?: string) => (href === '/' ? path === '/' : !!href && path.startsWith(href));
const groupActive = (item: (typeof NAV)[number]) =>
  isActive(item.href) || !!item.children?.some((c) => isActive(c.href));
---
<header class:list={['site-header', { 'over-photo': overPhoto }]}>
  <div class="wrap bar">
    <Logo />

    <button class="menu-toggle" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="burger" aria-hidden="true"></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul class="nav-list">
        {NAV.map((item) => (
          <li class:list={['nav-item', { 'has-sub': item.children, active: groupActive(item) }]}>
            {item.href ? (
              <a href={item.href} class="nav-link" aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            ) : (
              // Specialty and Resources are not pages: the label only opens its dropdown.
              <button type="button" class="nav-link nav-label" aria-expanded="false">{item.label}</button>
            )}
            {item.children && (
              <>
                {item.href && (
                  <button class="sub-toggle" aria-expanded="false" aria-label={`Show ${item.label} pages`}>
                    <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1.5 3.5 5 7l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.4"/></svg>
                  </button>
                )}
                <ul class="sub">
                  {item.children.map((c) => (
                    <li><a href={c.href} aria-current={path === c.href ? 'page' : undefined}>{c.label}</a></li>
                  ))}
                </ul>
              </>
            )}
          </li>
        ))}
      </ul>
      <a href={SITE.book} class="btn btn-primary nav-cta">Free Consultation</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header')!;
  const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle')!;
  toggle.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
    document.body.style.overflow = open ? 'hidden' : '';
  });

  const groups = [...header.querySelectorAll<HTMLElement>('.has-sub')];
  // Only one dropdown open at a time: opening or pointing at one closes the others.
  const closeOthers = (keep: HTMLElement) => {
    groups.forEach((g) => {
      if (g === keep) return;
      g.classList.remove('sub-open');
      g.querySelectorAll('.sub-toggle, .nav-label').forEach((b) => b.setAttribute('aria-expanded', 'false'));
      if (g.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
    });
  };
  groups.forEach((li) => {
    li.addEventListener('mouseenter', () => closeOthers(li));
    li.addEventListener('focusin', () => closeOthers(li));
  });

  header.querySelectorAll<HTMLElement>('.has-sub').forEach((li) => {
    const buttons = li.querySelectorAll<HTMLButtonElement>('.sub-toggle, .nav-label');
    const set = (open: boolean) => {
      if (open) closeOthers(li);
      buttons.forEach((b) => b.setAttribute('aria-expanded', String(open)));
      li.classList.toggle('sub-open', open);
    };
    buttons.forEach((b) => b.addEventListener('click', () => set(!li.classList.contains('sub-open'))));
    li.addEventListener('keydown', (e) => { if (e.key === 'Escape') { set(false); buttons[0]?.focus(); } });
    li.addEventListener('focusout', (e) => { if (!li.contains(e.relatedTarget as Node)) set(false); });
  });

  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--white);
    transition: box-shadow 0.2s, background 0.25s, color 0.25s;
  }
  .site-header.scrolled { box-shadow: 0 1px 0 var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 24px; min-height: 68px; }
  .bar :global(.logo img) { height: 24px; }

  .nav { display: flex; align-items: center; gap: 28px; }
  .nav-list { display: flex; align-items: center; gap: clamp(4px, 1.2vw, 16px); list-style: none; margin: 0; padding: 0; }
  .nav-item { position: relative; display: flex; align-items: center; }
  .nav-link {
    padding: 8px 8px;
    font-size: 0.84rem;
    letter-spacing: 0.01em;
    color: var(--text);
    text-decoration: none;
    white-space: nowrap;
  }
  button.nav-link { border: 0; background: none; cursor: pointer; }
  .nav-link:hover, .active > .nav-link { color: var(--ink); }
  .active > .nav-link { text-decoration: underline; text-underline-offset: 6px; text-decoration-color: var(--tan); }
  .sub-toggle {
    display: grid;
    place-items: center;
    width: 22px;
    height: 32px;
    margin-left: -4px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text);
    cursor: pointer;
  }
  .sub-toggle svg { transition: transform 0.2s; }
  .sub {
    position: absolute;
    top: 100%;
    left: -8px;
    min-width: 230px;
    margin: 0;
    padding: 10px;
    list-style: none;
    background: var(--white);
    border-radius: var(--radius-sm);
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s, transform 0.18s, visibility 0.18s;
  }
  .nav-cta { padding: 0.62em 1.15em; font-size: 0.82rem; }
  .sub a { display: block; padding: 8px 12px; border-radius: 6px; font-size: 0.86rem; text-decoration: none; color: var(--text); }
  .sub a:hover, .sub a[aria-current='page'] { background: var(--cream); color: var(--ink); }

  @media (min-width: 981px) {
    /* Desktop matches the design: plain labels, dropdowns open on hover or keyboard focus. */
    .sub-toggle { display: none; }
    .has-sub:hover .sub, .sub-open .sub, .has-sub:focus-within .sub { opacity: 1; visibility: visible; transform: none; }
    .nav-list:hover .has-sub:not(:hover) .sub { opacity: 0; visibility: hidden; transform: translateY(6px); }
    .menu-toggle { display: none; }
  }

  /* Over a full-bleed photo: transparent until the visitor scrolls. */
  .over-photo { position: fixed; left: 0; right: 0; }
  .over-photo:not(.scrolled):not(.open) { background: transparent; }
  @media (min-width: 981px) {
    .over-photo:not(.scrolled) .nav-list > li > .nav-link,
    .over-photo:not(.scrolled) .nav-list > li > .nav-link:hover { color: var(--white); }
    .over-photo:not(.scrolled) .active > .nav-link { text-decoration-color: rgba(255, 255, 255, 0.8); }
    .over-photo:not(.scrolled) .nav-cta { background: var(--white); color: var(--ink); }
  }
  .over-photo:not(.scrolled):not(.open) .burger,
  .over-photo:not(.scrolled):not(.open) .burger::before,
  .over-photo:not(.scrolled):not(.open) .burger::after { background: var(--white); }

  /* Mobile */
  .menu-toggle { display: none; width: 44px; height: 44px; border: 0; background: none; cursor: pointer; position: relative; z-index: 2; }
  .burger, .burger::before, .burger::after {
    position: absolute;
    left: 11px;
    width: 22px;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.25s, top 0.25s, opacity 0.2s;
    content: '';
  }
  .burger { top: 21px; }
  .burger::before { top: -7px; left: 0; }
  .burger::after { top: 7px; left: 0; }
  .open .burger { background: transparent !important; }
  .open .burger::before { top: 0; transform: rotate(45deg); }
  .open .burger::after { top: 0; transform: rotate(-45deg); }

  @media (max-width: 980px) {
    .bar { min-height: 60px; }
    .menu-toggle { display: block; }
    .nav {
      position: fixed;
      inset: 60px 0 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 12px var(--gutter) 32px;
      background: var(--white);
      overflow-y: auto;
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.2s, visibility 0.2s;
    }
    .open .nav { visibility: visible; opacity: 1; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-item { flex-wrap: wrap; justify-content: space-between; border-bottom: 1px solid var(--line); }
    .nav-link { padding: 16px 0; font-size: 1.05rem; flex: 1; text-align: left; }
    .sub-toggle { width: 44px; height: 44px; }
    .nav-label::after {
      content: '';
      float: right;
      width: 7px;
      height: 7px;
      margin: 6px 16px 0 0;
      border-right: 1.4px solid currentColor;
      border-bottom: 1.4px solid currentColor;
      transform: rotate(45deg);
      transition: transform 0.2s;
    }
    .sub-open .nav-label::after { transform: rotate(-135deg); margin-top: 10px; }
    .sub {
      position: static;
      flex-basis: 100%;
      min-width: 0;
      padding: 0 0 12px 12px;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
    }
    .sub-open .sub { display: block; }
    .sub-open .sub-toggle svg { transform: rotate(180deg); }
    .nav-cta { margin-top: 24px; padding: 1em; }
  }
</style>
