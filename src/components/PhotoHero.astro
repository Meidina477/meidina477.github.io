---
/**
 * Full-bleed photo hero from the 2026 designs. Use together with `<Base overPhoto>` so the
 * header sits transparently on top of the photo.
 *
 * layout="split"  (method pages): title + intro top left; the default slot (a second paragraph)
 *                  bottom left, with the button bottom right.
 * layout="center" (Retreats):     everything centred over the middle of the photo.
 * layout="bottom" (Booking):      title bottom left, intro bottom right, no button.
 */
import { Image } from 'astro:assets';
import { SITE } from '../data/site';

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  text?: string;
  image: ImageMetadata;
  imageAlt?: string;
  /** CSS object-position for the photo, e.g. "center 30%". */
  position?: string;
  cta?: { label: string; href: string } | false;
  layout?: 'split' | 'center' | 'bottom';
  /** Strength of the dark wash behind the text, 0–1. */
  shade?: number;
}
const {
  title,
  subtitle,
  eyebrow,
  text,
  image,
  imageAlt = '',
  position = 'center',
  cta = { label: 'Book Free Consultation', href: SITE.book },
  layout = 'split',
  shade = 0.35,
} = Astro.props;
const hasLower = Astro.slots.has('default');
---
<section class:list={['photo-hero', `layout-${layout}`]} style={`--shade: ${shade}`}>
  <Image
    src={image}
    alt={imageAlt}
    class="bg"
    style={`object-position: ${position}`}
    widths={[640, 960, 1280, 1600, 2000].filter((w) => w <= image.width)}
    sizes="100vw"
    loading="eager"
    fetchpriority="high"
  />
  <div class="wrap inner">
    <div class="top">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <h1 set:html={title} />
      {subtitle && <p class="subtitle serif" set:html={subtitle} />}
      {layout !== 'bottom' && text && <p class="intro" set:html={text} />}
      {layout === 'center' && cta && <div class="actions"><a href={cta.href} class="btn btn-light">{cta.label}</a></div>}
    </div>
    {layout === 'bottom' && text && <p class="intro side" set:html={text} />}
    {layout === 'split' && (hasLower || cta) && (
      <div class="lower">
        <div class="lower-text"><slot /></div>
        {cta && <a href={cta.href} class="btn btn-light">{cta.label}</a>}
      </div>
    )}
  </div>
</section>

<style>
  .photo-hero {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: clamp(600px, 100svh, 860px);
    color: var(--white);
    background: var(--green-dark);
    overflow: hidden;
  }
  .bg { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .photo-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to bottom, rgba(0, 0, 0, calc(var(--shade) + 0.1)) 0%, rgba(0, 0, 0, calc(var(--shade) * 0.4)) 45%, rgba(0, 0, 0, calc(var(--shade) * 0.9)) 100%);
  }
  .inner {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 48px;
    padding-block: clamp(120px, 14vw, 150px) clamp(48px, 9vw, 150px);
  }
  .top { max-width: 620px; padding-inline: clamp(0px, 3.5vw, 44px); }
  h1 { color: var(--white); font-size: clamp(2.6rem, 5vw, 3.6rem); margin-bottom: 0.55em; }
  .eyebrow { color: rgba(255, 255, 255, 0.8); }
  .intro, .lower-text :global(p) { font-size: 1.05rem; line-height: 1.5; color: var(--white); text-shadow: 0 1px 12px rgba(0, 0, 0, 0.25); }
  .lower {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px 48px;
    padding-inline: clamp(0px, 3.5vw, 44px);
  }
  .lower-text { max-width: 600px; }
  .lower .btn, .actions .btn { color: var(--ink); background: rgba(255, 255, 255, 0.92); }

  /* Retreats */
  .layout-center .inner { justify-content: center; text-align: center; padding-top: clamp(120px, 18vw, 200px); }
  .layout-center .top { max-width: 720px; margin-inline: auto; }
  .layout-center .subtitle { font-size: clamp(1.4rem, 2.4vw, 1.9rem); margin: -0.2em 0 0.6em; color: var(--white); }
  .layout-center .actions { justify-content: center; margin-top: 1.2rem; }
  .intro :global(.place) { display: block; margin-bottom: 1.1em; font-family: var(--serif); font-style: italic; font-size: 0.95rem; }

  /* Booking */
  .layout-bottom { min-height: clamp(460px, 72svh, 600px); }
  .layout-bottom h1 { font-size: clamp(2.6rem, 5vw, 3.4rem); }
  .layout-bottom .inner { flex-direction: row; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; }
  .layout-bottom .top { padding-inline: 0; }
  .layout-bottom h1 { margin: 0; }
  .layout-bottom .side { max-width: 460px; margin: 0 0 0.6em; }

  @media (max-width: 759px) {
    .photo-hero { min-height: 0; }
    .inner { padding-top: 112px; }
    .lower { flex-direction: column; align-items: flex-start; }
  }
</style>
