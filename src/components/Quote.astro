---
interface Props { text: string; by?: string; tone?: 'paper' | 'cream' | 'blush' | 'sand' | 'mist' }
const { text, by = 'Shabnam Lee, Licensed Counsellor', tone = 'sand' } = Astro.props;
---
<section class={`section-sm bg-${tone}`}>
  <figure class="wrap-narrow center">
    <blockquote set:html={`“${text}”`} />
    {by && <figcaption>{by}</figcaption>}
  </figure>
</section>

<style>
  figure { margin-block: 0; }
  blockquote {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }
  figcaption { margin-top: 1.2rem; font-size: 0.9rem; color: var(--muted); }
</style>
