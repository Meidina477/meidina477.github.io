---
// Jakarta landing pages: the methods as light cards inside a rounded green panel.
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items: { title: string; text: string; href?: string; linkLabel?: string }[];
}
const { eyebrow = 'How I work', title, intro, items } = Astro.props;
---
<section class="section bg-cream">
  <div class="wrap">
    <div class="panel">
      <div class="head">
        <span class="eyebrow">{eyebrow}</span>
        <h2 set:html={title} />
        {intro && <p set:html={intro} />}
      </div>
      <div class:list={['ocards', `n${items.length}`]}>
        {items.map((it) => (
          <div class="ocard">
            <h3 set:html={it.title} />
            <p set:html={it.text} />
            {it.href && <a href={it.href}>{it.linkLabel ?? 'Learn more'} →</a>}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .panel { background: var(--green); border-radius: 22px; padding: clamp(28px, 4vw, 48px); color: rgba(255, 255, 255, 0.88); }
  .head { max-width: 40em; }
  h2 { color: var(--white); }
  .eyebrow { color: rgba(255, 255, 255, 0.78); }
  .ocards { display: grid; gap: 14px; margin-top: 40px; }
  @media (min-width: 640px) { .ocards { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .ocards.n4 { grid-template-columns: repeat(4, 1fr); } .ocards.n3 { grid-template-columns: repeat(3, 1fr); } }
  .ocard { background: #f3f0eb; border-radius: var(--radius); padding: 22px 22px 20px; display: flex; flex-direction: column; color: var(--text); transition: transform 0.35s var(--ease-out); }
  @media (hover: hover) { .ocard:hover { transform: translateY(-3px); } }
  .ocard h3 { font-size: 1.3rem; margin-bottom: 0.45em; }
  .ocard p { font-size: 0.88rem; }
  .ocard :global(p a) { color: var(--tan-dark); }
  .ocard > a { margin-top: auto; padding-top: 10px; font-size: 0.84rem; color: var(--tan-dark); text-underline-offset: 4px; }
</style>
