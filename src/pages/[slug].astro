---
// Blog posts live at the site root (e.g. /why-you-keep-having-the-same-fight-and-how-to-finally-stop/), matching the old WordPress URLs.
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE } from '../data/site';
import { getPosts, excerpt, formatDate, readingTime, type Post } from '../data/blog';
import avatar from '../assets/img/shabnam-headshot.jpg';
import Icon from '../components/Icon.astro';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, all: posts } }));
}

const { post, all } = Astro.props as { post: Post; all: Post[] };
const { Content } = await render(post);
const d = post.data;
const description = excerpt(post);

const related = all
  .filter((p) => p.id !== post.id)
  .map((p) => ({ p, score: p.data.categories.filter((c) => d.categories.includes(c)).length }))
  .sort((a, b) => b.score - a.score || b.p.data.date.getTime() - a.p.data.date.getTime())
  .slice(0, 3)
  .map((r) => r.p);

const url = new URL(`/${post.id}/`, SITE.url).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  author: { '@type': 'Person', name: 'Shabnam Lee', url: `${SITE.url}/about/` },
  publisher: { '@type': 'Organization', name: SITE.title },
  mainEntityOfPage: url,
};
---
<Base title={`${d.title} | Shabnam Lee`} description={description} image={d.image} type="article" jsonLd={jsonLd}>
  <article>
    <header class="post-head bg-paper">
      <div class="wrap-narrow">
        <nav class="crumbs" aria-label="Breadcrumb">
          <a href="/blog/">Blog</a>
          {d.categories[0] && <><span aria-hidden="true">›</span><a href={`/blog/?topic=${encodeURIComponent(d.categories[0])}`}>{d.categories[0]}</a></>}
        </nav>
        <h1>{d.title}</h1>
        <div class="byline">
          <Image src={avatar} alt="" width={48} height={48} class="avatar" />
          <p class="meta">
            <a href="/about/" class="name">Shabnam Lee</a>
            <span><time datetime={d.date.toISOString()}>{formatDate(d.date)}</time></span>
            {d.updated && <span>Updated <time datetime={d.updated.toISOString()}>{formatDate(d.updated)}</time></span>}
            <span>{readingTime(post)} min read</span>
          </p>
        </div>
      </div>
      {d.image && (
        <div class="wrap hero-img">
          <Image src={d.image} alt={d.imageAlt} widths={[640, 960, 1200]} sizes="(min-width: 1180px) 1100px, 92vw" loading="eager" fetchpriority="high" />
        </div>
      )}
    </header>

    <div class="section-sm bg-paper post-body">
      <div class="wrap-narrow prose">
        <Content />
      </div>
      <div class="wrap-narrow share-row">
        <div>
          <p class="share-title">Share this post</p>
          <ul class="share">
            <li><a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener" aria-label="Share on LinkedIn"><Icon name="linkedin" size={18} /></a></li>
            <li><a href={`https://wa.me/?text=${encodeURIComponent(d.title + ' ' + url)}`} target="_blank" rel="noopener" aria-label="Share on WhatsApp"><Icon name="whatsapp" size={18} /></a></li>
            <li><a href={`mailto:?subject=${encodeURIComponent(d.title)}&body=${encodeURIComponent(url)}`} aria-label="Share by email"><Icon name="mail" size={18} /></a></li>
          </ul>
        </div>
        {d.categories.length > 0 && <ul class="tags">{d.categories.map((c) => <li><a href={`/blog/?topic=${encodeURIComponent(c)}`}>{c}</a></li>)}</ul>}
      </div>
      <aside class="wrap-narrow author">
        <Image src={avatar} alt="" width={56} height={56} class="avatar" />
        <div>
          <p class="eyebrow">About the author</p>
          <p><strong>Shabnam Lee</strong> is a licensed counsellor in Jakarta specialising in IFS and Relational Life Therapy, working with high-achieving individuals, couples and mothers in person and online.</p>
          <div class="actions">
            <a href={SITE.book} class="btn btn-primary">Book Free Consultation</a>
            <a href="/about/" class="link-underline">About Shabnam</a>
          </div>
        </div>
      </aside>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section bg-cream">
      <div class="wrap">
        <h2>Keep reading</h2>
        <div class="grid-3">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>

<style>
  .post-head { padding-top: clamp(40px, 6vw, 72px); }
  /* Always a clear gap between the featured image (or title) and the first paragraph. */
  .post-body { padding-top: clamp(40px, 5vw, 64px) !important; }
  .post-body .prose > :first-child { margin-top: 0; }
  .post-head h1 { font-size: clamp(2rem, 4vw, 2.8rem); color: var(--green-dark); }
  .crumbs { display: flex; gap: 10px; margin-bottom: 18px; font-size: 0.9rem; color: var(--ink); }
  .crumbs a { color: inherit; text-decoration: none; }
  .crumbs a:hover { text-decoration: underline; }
  .byline { display: flex; align-items: center; gap: 14px; margin-top: 8px; }
  .avatar { width: 48px; height: 48px; border-radius: 50%; object-fit: cover; object-position: top; flex: 0 0 auto; }
  .meta { margin: 0; font-size: 0.85rem; color: var(--muted); }
  .meta .name { display: block; color: var(--text); text-decoration: none; }
  .meta span + span::before { content: ' • '; }
  .hero-img { margin-top: 48px; }
  .hero-img img { width: 100%; max-height: 540px; object-fit: cover; border-radius: 8px; }
  .share-row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px; margin-top: 56px; padding-bottom: 32px; border-bottom: 1px solid var(--line); }
  .share-title { margin-bottom: 10px; color: var(--ink); }
  .share, .tags { display: flex; flex-wrap: wrap; gap: 8px; list-style: none; padding: 0; margin: 0; }
  .share a { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; color: var(--ink); background: var(--cream); }
  .share a:hover { background: var(--sand); }
  .tags a { display: inline-block; padding: 4px 10px; border-radius: 4px; background: #eceeea; font-size: 0.8rem; color: var(--ink); text-decoration: none; }
  .author { display: flex; gap: 18px; align-items: flex-start; margin-top: 32px; }
  .author .avatar { width: 56px; height: 56px; }
  .author p { margin-bottom: 0.6em; }
</style>
