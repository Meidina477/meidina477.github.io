---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SEO } from '../data/seo';
import { SITE } from '../data/site';
import VideoFeature from '../components/VideoFeature.astro';
import CtaBand from '../components/CtaBand.astro';
import desk from '../assets/photos/shabnam-laptop.png';
import practice from '../assets/photos/shabnam-emotions.png';
import aboutOg from '../assets/img/shabnam-about.png';

const credentials = ['Licensed Counsellor, ACA', 'IFS Levels 1, 2 and 3', 'Brainspotting', 'RLT Levels 1, 2 and 3', 'Gottman Levels 1 and 2'];

const clinical = [
  'Licensed Counsellor, Australian Counselling Association (Level 2, #25154)',
  'Internal Family Systems, Levels 1, 2 and 3 (IFS Institute)',
  'Relational Life Therapy, Levels 1, 2 and 3 (RLT)',
  'Brainspotting, Levels 1 and 2',
  'Gottman Method, Levels 1 and 2',
  'Intimacy from the Inside Out, IFS Couples Therapy',
  'Emotionally Focused Therapy (EFT)',
  'Acceptance and Commitment Therapy (ACT)',
  'Certified RLT Coach',
  'Certified RLT Intensive Coach',
];
const specialist = [
  'Perinatal and Infant Mental Health',
  'Post Traumatic Growth for Clinical Practice',
  'Polyvagal Theory in Therapy',
  'Neurodiversity Fundamentals for Mental Health Practitioners',
  'Metabolic Psychiatry Practitioners',
  'Neuroscience of Attachment',
];
const degrees = [
  { name: 'Master of Counselling', school: 'Monash University' },
  { name: 'MSc, Management Psychology', school: 'University of Nottingham' },
];
---
<Base {...SEO['about']} image={aboutOg}>
  <section class="section bg-cream about-hero">
    <div class="wrap">
      <div class="intro center">
        <span class="eyebrow visually-hidden">About Shabnam</span>
        <h1>I work with high achievers who are tired of managing and <em>ready to actually change.</em></h1>
        <p class="lead">I am a licensed counsellor, IFS and RLT specialist, mother, partner and former management consultant based in Jakarta.</p>
        <div class="actions"><a href={SITE.book} class="btn btn-tan">Book Free Consultation</a></div>
        <ul class="creds" aria-label="Credentials">{credentials.map((c) => <li>{c}</li>)}</ul>
      </div>
      <Image src={desk} alt="Shabnam Lee smiling while working at her laptop" class="rounded wide" widths={[640, 960, 1024]} sizes="(min-width: 1180px) 1100px, 92vw" loading="eager" />
    </div>
  </section>

  <section class="section bg-cream familiar">
    <div class="wrap-narrow prose-lg center">
      <span class="eyebrow">Sound familiar?</span>
      <h2>You have done everything right. <em>Something still feels misaligned.</em></h2>
      <p>The career, the relationship, the family, the plan. You followed through on every single part of it, did what was asked of you, built what you were supposed to build. From the outside, it worked.</p>
      <p class="serif pull">The feeling just does not match the life.</p>
      <p>Maybe it shows up as the tightness that settles into your chest on Sunday nights before the week begins again. Maybe it is the short fuse with your partner over something so small you feel embarrassed about it later. Maybe it is the fact that you finally hit the goal you had been working toward for years, felt almost nothing when you got there, and quietly moved the goalpost before anyone noticed.</p>
      <p>You are not falling apart. You are functioning at a high level, probably better than most people around you, which is exactly why no one sees it. You are not sure you are even allowed to say it out loud, because from where everyone else is standing, you have nothing to complain about. That is a particular kind of loneliness.</p>
      <p>You do not want a therapist who will sit across from you and nod for an hour while you narrate your own life back to yourself. You want someone who will be honest with you, who will push when pushing is what is needed, who will not be intimidated by the life you have built or the complexity of what is happening inside it.</p>
      <p class="serif pull">That is what this is.</p>
    </div>
  </section>

  <section class="section glow">
    <div class="wrap grid-2 why">
      <Image src={practice} alt="Shabnam Lee holding a cushion printed with an emotions wheel" class="rounded" widths={[480, 720, 1024]} sizes="(min-width: 760px) 560px, 92vw" />
      <div>
        <span class="eyebrow">A little more about me</span>
        <h2>Why I do this work</h2>
        <p>Before becoming a therapist, I trained in Management Psychology and spent a decade in corporate strategy consulting and leadership, working with individuals and teams in high-performance environments across China and Southeast Asia. That world taught me a great deal about pressure, performance and the cost of holding everything together. It also left me with a deep respect for the people who do it every day.</p>
        <p>I now live in Jakarta with my partner and son. I identify as a cisgender heterosexual woman and am guided by values rooted in my Bahá’í upbringing, including the oneness and equality of all humanity. I aim to provide a respectful, inclusive and affirming space for everyone who comes here.</p>
        <p>Outside of the work I am deeply committed to mind and body wellbeing. I practise yoga and calisthenics, I love to cook and I am genuinely passionate about nutrition. These things are not separate from the work for me. They are part of the same curiosity about how we take care of ourselves.</p>
      </div>
    </div>
  </section>

  <section class="section bg-green">
    <div class="wrap quals-card">
      <div class="quals-head">
        <span class="eyebrow">Qualifications</span>
        <h2>Training &amp; education</h2>
      </div>
      <div class="quals">
        <div class="card tint">
          <span class="eyebrow">Clinical training</span>
          <ul>{clinical.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div class="card tint">
          <span class="eyebrow">Specialist training</span>
          <ul>{specialist.map((c) => <li>{c}</li>)}</ul>
        </div>
        <div class="card tint degrees">
          {degrees.map((d) => (
            <div>
              <h3>{d.name}</h3>
              <p class="muted">{d.school}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <VideoFeature
    tone="paper"
    eyebrow="In conversation"
    title="What therapy with me actually looks and feels like."
    text="Shabnam sits down with Mikael Jasin, 2024 World Barista Champion, for an honest conversation about high achievement, identity and what it takes to do the deeper work."
    cta={false}
  />

  <CtaBand title="Something brought you here. <em>That is worth a conversation.</em>" />
</Base>

<style>
  .about-hero .intro { max-width: 820px; margin: 0 auto clamp(40px, 6vw, 64px); }
  .about-hero h1 { color: var(--ink); font-size: clamp(2.2rem, 4vw, 3.1rem); }
  .about-hero .lead { font-size: 1.05rem; color: var(--ink); max-width: 60ch; margin-inline: auto; }
  .btn-tan { background: var(--tan); color: var(--white); }
  .btn-tan:hover { background: var(--tan-dark); }
  .creds { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px; list-style: none; padding: 0; margin: 28px 0 0; }
  .creds li { padding: 5px 12px; border-radius: 6px; background: #e6e7e3; font-size: 0.8rem; color: var(--text); }
  .familiar { padding-top: 0; }
  .familiar h2 { font-size: clamp(1.4rem, 2.2vw, 1.7rem); }
  .why h2 { font-size: clamp(2.2rem, 4vw, 3rem); }
  .why p { color: var(--ink); }
  .quals-card { display: grid; gap: 28px 40px; padding: clamp(24px, 4vw, 40px); border-radius: 18px; background: var(--white); color: var(--text); }
  @media (min-width: 900px) { .quals-card { grid-template-columns: 0.7fr 2fr; } }
  .quals-head h2 { color: var(--ink) !important; font-size: clamp(1.7rem, 2.6vw, 2.1rem); }
  .quals-head .eyebrow { color: var(--text) !important; }
  .quals .card { background: #e6e7e3; box-shadow: none; font-size: 0.88rem; }
  .quals .eyebrow { color: var(--ink); letter-spacing: 0.02em; font-size: 0.85rem; }
  .degrees h3 { font-size: 1rem !important; font-family: var(--sans); color: var(--ink) !important; }
  .wide { width: 100%; box-shadow: var(--shadow); }

  .prose-lg p { font-size: 1.08rem; line-height: 1.75; }
  .pull { font-size: clamp(1.5rem, 2.6vw, 1.9rem) !important; line-height: 1.3 !important; color: var(--green-dark); margin-block: 1.4em; }

  .quals { display: grid; gap: 24px; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .quals { grid-template-columns: 1fr 1fr; } .degrees { grid-column: 1 / -1; } }
  .quals ul { margin: 0; padding-left: 1.1em; }
  .quals li { margin-bottom: 0.55em; }
  .degrees { display: grid; gap: 24px; grid-template-columns: 1fr 1fr; }
  .degrees p { font-size: 0.82rem; }
</style>
