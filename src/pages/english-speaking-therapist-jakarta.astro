---
import Base from '../layouts/Base.astro';
import { SEO } from '../data/seo';
import { CORE_METHODS } from '../data/methods';
import LandingHero from '../components/landing/LandingHero.astro';
import QuestionCards from '../components/landing/QuestionCards.astro';
import Strip from '../components/landing/Strip.astro';
import HalfPanel from '../components/landing/HalfPanel.astro';
import MethodPanel from '../components/landing/MethodPanel.astro';
import Stats from '../components/landing/Stats.astro';
import Steps from '../components/landing/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { LANDING_STATS, LANDING_STEPS } from '../data/landing';
import laptop from '../assets/photos/shabnam-laptop.png';
import onePractitioner from '../assets/img/est-one-practitioner.jpg';
---
<Base {...SEO['english-speaking-therapist-jakarta']}>
  <LandingHero
    eyebrow="In person in Jakarta. Online worldwide."
    title="English speaking therapist in <em>Jakarta</em>"
    text="Shabnam Lee is an English speaking therapist in Jakarta, working with internationals and locals in fluent English, in person in Jakarta and online worldwide. She is a licensed counsellor specialising in IFS and RLT, with training in Gottman and Brainspotting."
    image={laptop}
    imageAlt="Shabnam Lee smiling at her laptop during an online session"
    focus="42% 50%"
  />

  <QuestionCards
    title="This might be for you <em>if…</em>"
    items={[
      { title: 'An international or expat in Jakarta?', text: 'You want therapy in your own language, not a rough translation of it. Maybe you are an executive or founder far from home. You moved here, or you built it here, and something still feels off.' },
      { title: 'A local who thinks in English?', text: 'You have lived in Jakarta for years and simply want a therapist who works the way you think, in the language you think in. You do not want to translate your inner life before you can begin.' },
      { title: 'Holding it together on the outside?', text: 'Quietly running on empty on the inside. You have tried therapy before and it did not go deep enough, and you want someone who will be honest with you and push when pushing is what is needed, not nod for an hour.' },
    ]}
  />

  <Strip text="Warm, direct, confidential therapy in English, <em>for people who are done coping and ready to actually change.</em>" />

  <HalfPanel image={onePractitioner} alt="A person sitting thoughtfully in a leather armchair in a sunlit room" eyebrow="The approach" title="An English speaking therapist who specialises, <em>not a general clinic.</em>" button={{ label: 'About Shabnam →', href: '/about/' }}>
    <p>Plenty of places in Jakarta will see you in English. Far fewer offer one senior practitioner, working in distinct evidence-based methods, with longer sessions built for real change.</p>
    <p>I do not hand you between counsellors or run you through a standard intake and a generic plan. You work with me. I bring <a href="/about/">over two decades of mental health training</a> together with a decade in corporate strategy consulting across China and Southeast Asia, so I understand the world high achievers actually live in.</p>
    <p>If you want the broader overview first, start with my main page on working with a <a href="/therapist-in-jakarta/">therapist in Jakarta</a>.</p>
  </HalfPanel>

  <MethodPanel
    title="The methods I work with"
    intro="An integrative approach, chosen for what each method reaches. Not one lens. The full picture."
    items={CORE_METHODS}
  />

  <Stats items={LANDING_STATS} />

  <Steps
    title="How working together <em>begins</em>"
    intro="In person in Jakarta and online worldwide. If you travel often, split time between countries, or have moved away from Jakarta, we can continue online without losing momentum."
    items={LANDING_STEPS}
  />

  <Faq
    tone="tan"
    title="Frequently asked <em>questions</em>"
    items={[
      { q: 'Do you offer therapy in English in Jakarta?', a: 'Yes. I work in fluent English with both internationals and locals, in person in Jakarta and online worldwide. You do not need to translate your inner life to begin.' },
      { q: 'Do you only work with expats?', a: 'No. I work with internationals and locals alike. What my clients share is that they think and process in English and want a therapist who meets them there.' },
      { q: 'Can we meet online if I am outside Jakarta?', a: 'Yes. Sessions are available online worldwide, as <a href="/ifs-therapy-intensive/">intensives</a> or <a href="/individual-therapy/">ongoing weekly work</a>. International pricing is adjusted for parity.' },
      { q: 'What kind of therapist are you?', a: 'I am a licensed counsellor (ACA) specialising in IFS and RLT, based in Jakarta, with training in Gottman and Brainspotting, and additional training in ACT and perinatal mental health. For couples I also offer <a href="/couple-therapy/">couple therapy</a> and <a href="/marriage-counseling-jakarta/">marriage counselling in Jakarta</a>.' },
    ]}
  />

  <CtaBand layout="inline" title="A free 15-minute conversation." />
</Base>
