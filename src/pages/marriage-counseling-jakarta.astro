---
import Base from '../layouts/Base.astro';
import { SEO } from '../data/seo';
import LandingHero from '../components/landing/LandingHero.astro';
import QuestionCards from '../components/landing/QuestionCards.astro';
import Strip from '../components/landing/Strip.astro';
import HalfPanel from '../components/landing/HalfPanel.astro';
import MethodPanel from '../components/landing/MethodPanel.astro';
import Stats from '../components/landing/Stats.astro';
import Steps from '../components/landing/Steps.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import hero from '../assets/img/pexels-vo-van-ti-n-2037497312-35841805-scaled.jpg';
import ring from '../assets/img/marriage-counseling-commitment-ring.jpg';
---
<Base {...SEO['marriage-counseling-jakarta']}>
  <LandingHero
    eyebrow="In person in Jakarta. Online worldwide."
    title="Marriage counseling in <em>Jakarta</em>"
    text='Marriage counselling in Jakarta is focused work for two people who are committed to each other and want the relationship to hold. I am a <a href="/therapist-in-jakarta/">licensed counsellor working in person in Jakarta</a> and online worldwide, drawing on Relational Life Therapy and the Gottman Method to help married couples move out of the same argument and back toward each other.'
    image={hero}
    imageAlt="A couple together"
    focus="50% 40%"
    secondary={{ label: 'Couple therapy', href: '/couple-therapy/' }}
  />

  <QuestionCards
    title="This work is for you if you are married and want to stay married, <em>and you recognise some of this.</em>"
    items={[
      { title: 'The same fight keeps returning?', text: 'You love each other, but <a href="/why-you-keep-having-the-same-fight-and-how-to-finally-stop/">the same fight keeps returning</a>, and nothing gets resolved. You have tried talking it through on your own and keep landing in the same place.' },
      { title: 'Drifted into parallel lives?', text: 'The careers are established, the household runs, the children are cared for. In private, you have become efficient roommates who have <a href="/your-relationship-isnt-dying-from-a-lack-of-love-its-dying-from/">quietly stopped turning toward each other</a>. You want closeness back, not just a truce.' },
      { title: 'Has trust been damaged, or has leaving come up?', text: 'Trust has been damaged and you are not sure whether it can be rebuilt. Or one of you has raised the idea of leaving, and you want to give the marriage a real, honest try first.' },
    ]}
  />

  <Strip text="You are not in crisis. You are running on empty. <em>It does not have to stay this way.</em>" />

  <HalfPanel image={ring} alt="A hand wearing a gold wedding ring resting on warm wooden slats in afternoon light" eyebrow="How marriage counselling is different" title="Not the same as general couples therapy, <em>and the difference matters.</em>" button={{ label: 'General couple therapy →', href: '/couple-therapy/' }}>
    <p>General couples work often supports two people in deciding what they want, including whether to stay together at all. Marriage counselling starts from a shared commitment to the marriage itself. The question is not whether to stay, but how to rebuild the connection you committed to, honestly and without pretending the hard parts away.</p>
    <p>That difference shapes the room. We name the patterns you have both fallen into, look at what each of you brings from your own history, and practise turning toward each other rather than scoring points.</p>
    <p>If you are not married, or you are still deciding whether this relationship is one you want to continue, my general couples therapy may fit you better.</p>
  </HalfPanel>

  <MethodPanel
    title="The methods I work with"
    intro="I work relationally and practically. My primary approaches for married couples are Relational Life Therapy, in which I hold training at Levels 1, 2 and 3, and the Gottman Method, in which I hold training at Levels 1 and 2."
    items={[
      { title: 'Relational Life Therapy', text: 'Direct and honest. It does not let either partner hide behind being the reasonable one, and it helps you see the moves you each make that keep the distance in place.', href: '/rlt/', linkLabel: 'Learn about RLT' },
      { title: 'The Gottman Method', text: 'Gives us a clear, well-researched map of what makes marriages work, so we are building on more than good intentions.', href: '/gottman/', linkLabel: 'Learn about Gottman' },
      { title: 'I am also a licensed counsellor', text: 'Accredited by the Australian Counselling Association, with training in <a href="/brainspotting/">Brainspotting</a>, Acceptance and Commitment Therapy, and Perinatal Mental Health. When something in an individual history is driving the pattern between you, I can work with that too, rather than sending you elsewhere.', href: '/how-i-work/', linkLabel: 'Learn how I work' },
    ]}
  />

  <Stats
    items={[
      { n: '3', label: 'levels of Relational Life Therapy training' },
      { n: '2', label: 'levels of Gottman Method training' },
      { n: '20+', label: 'years of mental health training' },
      { n: '15', label: 'minutes for a free first conversation, online, no commitment' },
    ]}
  />

  <Steps
    eyebrow="What a first session looks like"
    title="Not an interrogation. <em>Not couples combat with a referee.</em>"
    intro="It is a calm, honest conversation. Sessions are conducted in English."
    items={[
      { title: 'A free consultation', text: 'We begin with a free 15-minute consultation so the three of us can feel whether this is the right fit before you commit to anything.' },
      { title: 'Both of you are heard', text: 'In the first full session, I listen to how each of you sees things, in your own words, without one story being treated as the correct one.' },
      { title: 'We map the cycle', text: 'Together we start to map the cycle you keep repeating, so that for the first time in a while you are looking at the pattern together rather than blaming each other for it. You leave with a clear sense of what the work would involve, and no pressure to continue if it does not feel right.' },
      { title: 'In person or online', text: 'In person in Jakarta, away from the household and the phones, or online for demanding schedules, frequent travel, or a partner living in another city or country.' },
    ]}
  />

  <Faq
    tone="tan"
    title="Frequently asked <em>questions</em>"
    items={[
      { q: 'What if only one of us wants to come?', a: 'That is very common. One partner is often more ready than the other. It is fine to begin with a conversation on your own about where things stand and what your options are. Many couples start exactly this way. That first stretch can also run as <a href="/individual-therapy/">individual therapy</a> while your partner decides.' },
      { q: 'Is it too late for us?', a: 'If you are both willing to try honestly, there is usually something to work with, even after years of distance or a serious breach of trust. Whether the marriage can be rebuilt depends on what you both want and are prepared to do, and the first sessions help you see that clearly.' },
      { q: 'Do you offer sessions in English?', a: 'Yes. All sessions are conducted in English, which suits expatriate, cross-cultural and international couples who want to do this work in the language they are most themselves in. If you are looking for individual work rather than couples work, I also see clients as an <a href="/english-speaking-therapist-jakarta/">English speaking therapist in Jakarta</a>.' },
      { q: 'How much does marriage counselling cost?', a: 'The free 15-minute consultation lets us discuss fit and current fees before you commit to anything.' },
    ]}
  />

  <CtaBand layout="inline" title="If you are both willing to try, <em>the next step is small.</em>" />
</Base>
