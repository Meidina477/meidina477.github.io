---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { TESTIMONIALS } from '../data/testimonials';

const items = Object.values(TESTIMONIALS);
---
<Base
  title="Client Testimonials | Shabnam Lee"
  description="What clients say about individual, couple and intensive therapy with Shabnam Lee in Jakarta, Bali and online."
>
  <section class="section bg-sand">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Client stories</span>
        <h1>What changes when the work goes deep</h1>
      </div>
      <ul class="quotes">
        {items.map((t) => (
          <li class="card">
            <figure>
              <blockquote>{t.quote.split('\n\n').map((p) => <p>{p}</p>)}</blockquote>
              <figcaption>{t.name}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  h1 { color: var(--green-dark); font-size: clamp(2.2rem, 4vw, 3.1rem); }
  .quotes { list-style: none; margin: 0; padding: 0; columns: 1; column-gap: 24px; }
  @media (min-width: 760px) { .quotes { columns: 2; } }
  @media (min-width: 1100px) { .quotes { columns: 3; } }
  .quotes li { break-inside: avoid; margin-bottom: 24px; }
  figure { margin: 0; }
  blockquote { margin: 0; font-style: italic; line-height: 1.6; color: var(--ink); }
  blockquote p:first-child::before { content: '“'; }
  blockquote p:last-child::after { content: '”'; }
  figcaption { margin-top: 1.2rem; font-size: 0.9rem; color: var(--muted); }
</style>
