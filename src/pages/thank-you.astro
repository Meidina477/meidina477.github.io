---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base title="Thank you | Shabnam Lee" description="Your enquiry has been received." noindex>
  <section class="section bg-cream">
    <div class="wrap-narrow center">
      <span class="eyebrow">Enquiry received</span>
      <h1>Thank you. <em>Reaching out is a real step.</em></h1>
      <p class="lead">Your enquiry has arrived safely. We’ll be in touch by email or WhatsApp to arrange your free 15-minute consultation. Our working hours are Tuesday to Friday, 8:30 AM to 4:00 PM.</p>
      <p>If anything is urgent, you can message us on <a href={SITE.whatsapp}>WhatsApp</a>.</p>
      <div class="actions"><a href="/" class="btn btn-primary">Back to home</a><a href="/blog/" class="link-underline">Read the blog</a></div>
    </div>
  </section>
</Base>

<style>
  h1 { color: var(--green-dark); }
  a:not(.btn) { color: var(--green); }
  .small { font-size: 0.9rem; margin-top: 1.5rem; }
</style>
