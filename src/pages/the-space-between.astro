---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { SEO } from '../data/seo';
import phone from '../assets/img/spce-berween-scaled.png';
import iconDaily from '../assets/img/frame-365.png';
import iconCapture from '../assets/img/frame-366.png';
import iconSteady from '../assets/img/frame-367.png';
import iconPrep from '../assets/img/frame-367-1.png';

const APP = 'https://the-space-between.netlify.app/';

const features = [
  { icon: iconDaily, title: 'A daily moment to access Self energy', text: 'A short reflection each day, drawn from the ideas in your work, to help you reconnect with the calm and clarity already in you.' },
  { icon: iconCapture, title: 'Capture what comes up', text: 'Log the parts you meet, the moments that activate you, and what surfaces with the people close to you, while it’s fresh.' },
  { icon: iconSteady, title: 'Steady yourself when you’re triggered', text: 'When a feeling is too big for the moment, a guided practice helps you settle, with breath, grounding, and turning inward, before you react.' },
  { icon: iconPrep, title: 'Prep for your session', text: 'Gather what you’d like to focus on and bring it into your next session, so you arrive with the thread already in hand.' },
];

const iphone = [
  'Open <strong>the-space-between.netlify.app</strong> in Safari.',
  'Tap the <strong>Share</strong> icon in the toolbar at the bottom of the screen.',
  'Scroll down and tap <strong>Add to Home Screen</strong>.',
  'Tap <strong>Add</strong> in the top right corner. Look for The Space Between on your home screen.',
];
const android = [
  'Open <strong>the-space-between.netlify.app</strong> in Chrome.',
  'Tap the <strong>menu</strong> (three dots) in the top right corner.',
  'Tap <strong>Add to Home screen</strong>, or <strong>Install app</strong>.',
  'Tap <strong>Add</strong> or <strong>Install</strong> to confirm. Look for The Space Between on your home screen.',
];
---
<Base {...SEO['the-space-between']}>
  <section class="hero">
    <div class="wrap-narrow center">
      <span class="eyebrow tan">A support tool | For your therapy</span>
      <h1>The work doesn’t stop<br />between sessions.</h1>
      <p class="intro">A space curated for your therapy journey, to keep you close to the work between sessions. Capture what comes up, return to it, and bring it back in when you’re ready.</p>
      <div class="actions">
        <a href={APP} class="btn btn-primary" target="_blank" rel="noopener">Open The Space Between</a>
        <a href="#add-to-phone" class="btn btn-outline-light">Add to Your Home Screen</a>
      </div>
      <p class="private">Private by design. Everything stays on your own phone.</p>
    </div>
    <div class="phone-wrap">
      <Image src={phone} alt="The Space Between app on a phone, showing a daily reflection card" class="phone" widths={[300, 450, 600]} sizes="(min-width: 760px) 300px, 60vw" loading="eager" />
    </div>
  </section>

  <section class="section bg-green band">
    <div class="wrap-narrow center">
      <h2>Therapy happens in the room. Life happens everywhere else.</h2>
      <p>The Space Between holds the thread between your sessions. When something stirs, a feeling, a part of you, a moment with someone you love, you can meet it here, gently, and carry it back into your next session instead of losing it.</p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="wrap">
      <ul class="features">
        {features.map((f) => (
          <li>
            <Image src={f.icon} alt="" width={56} height={56} class="icon" />
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
      <p class="after center">Alongside a plain-language glossary of the ideas in your work, and private by design, nothing leaves your phone or is seen by anyone unless you choose to share it.</p>
      <p class="after center serif tagline"><em>Small moments of returning, between the sessions that hold them.</em></p>
    </div>
  </section>

  <section class="section bg-white add" id="add-to-phone">
    <div class="wrap">
      <div class="section-head center">
        <h2>Add it to your phone</h2>
        <p>The Space Between works right from your home screen, like any other app, with nothing to download from an app store. Here’s how to add it:</p>
        <div class="actions"><a href={APP} class="btn btn-primary" target="_blank" rel="noopener">Open The Space Between</a></div>
      </div>
      <div class="os-grid">
        {[['On iPhone (Safari)', iphone], ['On Android (Chrome)', android]].map(([label, steps]) => (
          <div class="os-card">
            <span class="os">{label}</span>
            <ol class="steps">{(steps as string[]).map((st) => <li><span set:html={st} /></li>)}</ol>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding-block: clamp(56px, 8vw, 96px) clamp(48px, 6vw, 80px); background: radial-gradient(ellipse 38% 42% at 50% 72%, #c6cec4 0%, #e3e8e1 35%, var(--white) 72%); }
  .tan { color: var(--tan); }
  .hero h1 { font-size: clamp(2.3rem, 4.6vw, 3.3rem); color: var(--ink); }
  .intro { max-width: 60ch; margin-inline: auto; font-size: 0.98rem; color: var(--ink); }
  .btn-outline-light { background: var(--white); color: var(--ink); border-color: var(--line); }
  .btn-outline-light:hover { border-color: var(--ink); }
  .private { margin-top: 1.4rem; font-size: 0.85rem; color: var(--muted); opacity: 0.8; }
  .phone-wrap { display: flex; justify-content: center; margin-top: 16px; }
  .phone { width: 100%; max-width: 280px; height: auto; filter: drop-shadow(0 30px 40px rgba(40, 50, 40, 0.25)); }

  .band { padding-block: clamp(80px, 10vw, 140px); }
  .band h2 { font-size: clamp(1.9rem, 3.4vw, 2.5rem); }
  .band p { max-width: 62ch; margin-inline: auto; }

  .features { display: grid; gap: 40px 32px; grid-template-columns: 1fr; list-style: none; padding: 0; margin: 0 auto; max-width: 1000px; text-align: center; }
  @media (min-width: 560px) { .features { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1000px) { .features { grid-template-columns: repeat(4, 1fr); } }
  .features .icon { width: 64px; height: 64px; margin: 0 auto 28px; border-radius: 50%; }
  .features h3 { font-size: clamp(1.25rem, 1.8vw, 1.45rem); margin-bottom: 0.45em; }
  .features p { font-size: 0.98rem; line-height: 1.45; color: var(--text); max-width: 26ch; margin-inline: auto; }
  .after { max-width: 640px; margin: clamp(56px, 7vw, 96px) auto 0; font-size: 1.1rem; line-height: 1.5; color: var(--muted); }
  .tagline { max-width: 680px; margin-top: 24px; font-size: clamp(1.6rem, 3vw, 2.3rem); color: var(--text); line-height: 1.25; }

  .add { padding-top: 0; }
  .add h2 { font-size: clamp(1.7rem, 2.6vw, 2.1rem); }
  .add .section-head p { max-width: 52ch; margin-inline: auto; }
  .os-grid { display: grid; gap: 32px; grid-template-columns: 1fr; max-width: 1000px; margin: 0 auto; }
  @media (min-width: 760px) { .os-grid { grid-template-columns: 1fr 1fr; } }
  .os-card { padding: clamp(28px, 4vw, 44px); border-radius: var(--radius); background: #f3f0eb; box-shadow: var(--shadow); }
  .os { display: block; padding-bottom: 16px; margin-bottom: 28px; border-bottom: 1px solid var(--tan); font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.02em; color: var(--tan); }
  .steps { list-style: none; counter-reset: s; padding: 0; margin: 0; display: grid; gap: 22px; }
  .steps li { counter-increment: s; display: grid; grid-template-columns: 40px 1fr; gap: 16px; align-items: center; font-size: 0.92rem; color: var(--ink); }
  .steps li::before { content: counter(s); display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: #d8d9d5; color: var(--ink); font-size: 0.85rem; }
  .steps :global(strong) { font-weight: 600; }
</style>
